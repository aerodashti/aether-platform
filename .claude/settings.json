{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx --no -- commitlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose -f infra/docker-compose.yml:*)"
    ]
  }
}
