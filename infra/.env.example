# Copie para infra/.env antes de subir o Compose: cp infra/.env.example infra/.env
# Estes valores são de desenvolvimento local. Nunca use em produção.

POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_PORT=5432

# Lido pelo backend (application.yml). Precisa bater com os valores acima.
AETHER_BANCO_URL=jdbc:postgresql://localhost:5432/aether
AETHER_BANCO_USUARIO=aether
AETHER_BANCO_SENHA=aether
